{
  "name": "extensive-typescript-koans",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "koan": "node --import tsx scripts/koan.ts",
    "progress": "node --import tsx scripts/progress.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:koan": "node --import tsx scripts/typecheck-koan.ts",
    "validate:syllabus": "node --import tsx scripts/validate-syllabus.ts",
    "verify:koan": "node --import tsx scripts/verify-koan.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/typescript6": "^6.0.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
